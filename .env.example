# ===== toolcall-gateway 配置示例（复制成 .env 后填真实值）=====
# docker compose 直接用 .env；本机裸跑可用 node --env-file=.env src/server.mjs

# 监听端口（容器内固定 8787，对外用 HOST_PORT 控制）
PORT=8787
HOST_PORT=8787

# 上游：兼容 OpenAI /v1/chat/completions、但只支持纯聊天的接口
UPSTREAM_BASE_URL=https://api.deepseek.com
# 真实密钥请只写在 .env 里，不要提交；网关日志永远不会打印它
UPSTREAM_API_KEY=sk-REPLACE_ME

# 可选：请求未指定 model 时使用
DEFAULT_MODEL=deepseek-chat

# ---- 模型映射（Codex 等客户端会送 gpt-5-codex 之类模型名）----
# JSON 或 from:to,from2:to2 两种写法都支持
MODEL_MAP={"gpt-5-codex":"deepseek-chat","gpt-4o":"deepseek-chat"}
# 硬覆盖：设置后所有请求都改写成这个上游模型（优先级最高）
MODEL_OVERRIDE=

# 下游鉴权（可选）：设置后要求 Authorization: Bearer <GATEWAY_API_KEY>；
# 发往上游时始终改用 UPSTREAM_API_KEY，客户端 key 不会被转发
GATEWAY_API_KEY=

# ---- 应用内设置页 ----
# 设置页默认只允许本机（127.0.0.1/::1）访问；要从别的机器打开，请设置下面的令牌，
# 然后用 Authorization: Bearer <ADMIN_TOKEN> 访问 /admin
ADMIN_TOKEN=
# 设置文件目录（容器内建议保持 data，并挂载 volume；见 docker-compose *.yml）
DATA_DIR=data
# 可选：直接指定 settings.json 的完整路径（优先级高于 DATA_DIR）
SETTINGS_FILE=

# auto = 含 tools/functions 时启用提示词模拟；off = 完全透传（不模拟）
TOOL_MODE=auto

# 上游 reasoning_content / reasoning 是否原样透传（on/off）
REASONING_PASSTHROUGH=on

# 单次上游请求超时（毫秒）
REQUEST_TIMEOUT_MS=60000

# 入站请求体上限（字节），超过返回 413
MAX_BODY_BYTES=2097152

# debug 会打印注入后的上游 prompt（仍然脱敏，不含密钥）
LOG_LEVEL=info

# ---- live 脚本（conformance / hitrate / e2e_live / e2e_codex）----
# 真实模型（账号里能用的那个），以及每个脚本进程最多打多少次真实上游
LIVE_MODEL=deepseek-chat
MAX_LIVE_CALLS=40
# 请求间隔（毫秒），web 类上游容易被高频调用触发人机验证
LIVE_DELAY_MS=2000
