# 全部可选。零配置部署不需要这个文件：
# 上游地址 / 密钥 / 管理员账号都在首次打开 http://<host>:8787/admin 时用网页填写。
#
# 只有在下面这些场景才需要 env：
#   - 想用 CI / 脚本预置上游（不想动网页）
#   - 想用 ADMIN_TOKEN 做自动化或忘记密码时兜底
#   - 想改端口、超时、日志级别等运行参数
#
# 用法：cp .env.example .env ，再在 docker compose 里把 environment 段落打开（或本地 export）。

# ---------- 上游（可选；网页里填的优先级更高） ----------
# UPSTREAM_BASE_URL=https://api.deepseek.com
# UPSTREAM_API_KEY=sk-xxxxxxxx
# DEFAULT_MODEL=deepseek-chat
# MODEL_MAP={"gpt-5-codex":"deepseek-web-flash","gpt-4o":"deepseek-web-flash"}
# MODEL_OVERRIDE=
# TOOL_MODE=auto                 # auto=提示词模拟工具调用 / off=完全透传
# REASONING_PASSTHROUGH=on       # 原样带 reasoning_content，不并入 content

# ---------- 网关（可选） ----------
# GATEWAY_API_KEY=               # 设了才校验下游 Bearer；不设=任意 key 放行
# ADMIN_TOKEN=                   # 设了多一把管理令牌（Bearer 访问 /admin）
# REQUEST_TIMEOUT_MS=60000
# MAX_BODY_BYTES=2097152

# ---------- 运行时 ----------
# PORT=8787
# DATA_DIR=data
# LOG_LEVEL=info

# ---------- 真实联调脚本用（不会被网关读取） ----------
# LIVE_MODEL=deepseek-web-flash
# MAX_LIVE_CALLS=40
